+async def list_invoices(
+    cursor: str | None = None,
+    limit: int = Query(50, ge=1, le=200),
+    merchant=Depends(current_merchant),
+):
+    after = datetime.fromisoformat(base64.urlsafe_b64decode(cursor).decode()) if cursor else None
+    rows = await db.fetch(
+        """
+        SELECT * FROM invoices
+        WHERE merchant_id = $1 AND ($2::timestamptz IS NULL OR created_at < $2)
+        ORDER BY created_at DESC
+        LIMIT $3
+        """,
+        merchant.id, after, limit,
+    )
+    next_cursor = (
+        base64.urlsafe_b64encode(rows[-1]["created_at"].isoformat().encode()).decode()
+        if len(rows) == limit else None
+    )
+    return {
+        "data": [InvoiceOut.from_row(r) for r in rows],
+        "pagination": {"next_cursor": next_cursor, "has_more": next_cursor is not None},
+    }


 @router.get("/v2/invoices/{invoice_id}")
 async def get_invoice(invoice_id: str, merchant=Depends(current_merchant)):
     inv = await db.invoices.get(invoice_id, merchant.id)
     if inv is None:
         raise HTTPException(404)
-    return InvoiceOut.from_model(inv)
+    return JSONResponse(InvoiceOut.from_model(inv).model_dump(mode="json"), headers={"ETag": etag_for(inv)})
+
+
+@router.patch("/v2/invoices/{invoice_id}")
+async def patch_invoice(
+    invoice_id: str,
+    patch: dict = Body(..., media_type="application/merge-patch+json"),
+    if_match: str | None = Header(None, alias="If-Match"),
+    merchant=Depends(current_merchant),
+):
+    inv = await db.invoices.get(invoice_id, merchant.id)
+    if inv is None:
+        raise HTTPException(404)
+    if if_match and if_match != etag_for(inv):
+        raise HTTPException(412, "Precondition Failed")
+    for field, value in patch.items():
+        if field in EDITABLE_FIELDS and value is not None:
+            setattr(inv, field, value)
+    await db.invoices.save(inv)  # sets updated_at = now()
+    return JSONResponse(InvoiceOut.from_model(inv).model_dump(mode="json"), headers={"ETag": etag_for(inv)})
