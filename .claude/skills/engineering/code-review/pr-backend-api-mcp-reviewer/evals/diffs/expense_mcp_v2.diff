+import os
+
+from mcp.server.caching import CacheHint
+from mcp.server.auth.settings import AuthSettings
+from mcp.server.mcpserver import Context, Image, MCPServer, RequestStateSecurity
+from mcp.server.transport_security import TransportSecuritySettings
+from mcp.types import (
+    ElicitRequest,
+    ElicitRequestFormParams,
+    ElicitResult,
+    InputRequiredResult,
+    ToolAnnotations,
+)
+
+from .auth import OktaTokenVerifier, RoleFilteredTools, current_user
+from .store import expenses_db, receipts
+
+PIN_SCHEMA = {
+    "type": "object",
+    "properties": {
+        "pin": {"type": "string", "description": "Your 6-digit approval PIN", "minLength": 6, "maxLength": 6},
+    },
+    "required": ["pin"],
+}
+
+mcp = MCPServer(
+    "expenses",
+    token_verifier=OktaTokenVerifier(audience="api://expenses-mcp"),
+    auth=AuthSettings(
+        issuer_url="https://acme.okta.com/oauth2/default",
+        resource_server_url="https://expenses-mcp.acme.internal/mcp",
+        required_scopes=["expenses"],
+    ),
+    request_state_security=RequestStateSecurity(
+        keys=[os.environ.get("REQUEST_STATE_KEY", "expenses-dev-request-state-key")],
+        bind_principal=None,  # identity is already enforced by the gateway + token verifier
+    ),
+    cache_hints={"tools/list": CacheHint(ttl_ms=60 * 60 * 1000, scope="public")},
+    middleware=[RoleFilteredTools(admin_only={"expenses.reimburse"})],
+)
+
+
+@mcp.tool(
+    name="expenses.list_pending",
+    description="List expenses awaiting your approval, with their receipts, newest first.",
+    annotations=ToolAnnotations(readOnlyHint=True),
+)
+def list_pending(limit: int = 200) -> list:
+    out = []
+    for e in expenses_db.pending_for_approver(current_user(), limit=limit):
+        out.append(e.summary())
+        for r in receipts.for_expense(e.id):
+            out.append(Image(data=r.bytes, format=r.format))
+    return out
+
+
+@mcp.tool(
+    name="expenses.approve",
+    description="Approve a pending expense you are the approver for. Asks you to confirm with your approval PIN.",
+    annotations=ToolAnnotations(destructiveHint=False, idempotentHint=True),
+)
+async def approve(expense_id: str, ctx: Context) -> str | InputRequiredResult:
+    expense = expenses_db.get(expense_id)
+    if expense is None:
+        raise ValueError(f"expense {expense_id} not found")
+    if expense.status != "pending":
+        raise RuntimeError(f"expense {expense_id} is {expense.status}")
+
+    responses = ctx.input_responses
+    if responses is None or "pin" not in responses:
+        ask = ElicitRequest(
+            params=ElicitRequestFormParams(
+                message=f"Approve {expense.summary_line()}? Enter your approval PIN to confirm.",
+                requested_schema=PIN_SCHEMA,
+            )
+        )
+        return InputRequiredResult(
+            input_requests={"pin": ask},
+            request_state=f"approve:{expense_id}:{expense.approver_id}",
+        )
+
+    _, state_expense_id, approver_id = ctx.request_state.split(":")
+    answer = responses["pin"]
+    if not (isinstance(answer, ElicitResult) and answer.action == "accept"):
+        return "Approval cancelled."
+    if not expenses_db.check_pin(approver_id, answer.content["pin"]):
+        raise PermissionError("invalid PIN")
+    expenses_db.approve(state_expense_id, approver=approver_id)
+    return f"Approved {state_expense_id}"
+
+
+@mcp.tool(
+    name="expenses.reimburse",
+    description="Trigger reimbursement payout for an approved expense. Finance admins only.",
+    annotations=ToolAnnotations(destructiveHint=True),
+)
+def reimburse(expense_id: str) -> str:
+    payout = expenses_db.reimburse(expense_id, by=current_user())
+    return f"Payout {payout.id} scheduled for {payout.amount_display}"
+
+
+app = mcp.streamable_http_app(
+    host="0.0.0.0",
+    transport_security=None,
+)
