PR #340 — feat(billing): transactional outbox, usage-credit consumer, cached plan lookups

Description (from PR body):
  - Adds a transactional outbox so `usage.recorded` and `plan.changed` events reach SQS reliably.
    The relay runs as 3 replicas (HPA) for throughput.
  - New SQS consumer debits prepaid usage credits per `usage.recorded` event and emails the
    customer when their balance drops below 10% of what they bought. Duplicate deliveries are
    handled via a processed_events table.
  - Plan lookups (hot path on every API call for entitlement checks) are cached in Redis for
    5 minutes; changing plan invalidates the key.

diff --git a/billing/outbox/relay.py b/billing/outbox/relay.py
new file mode 100644
--- /dev/null
+++ b/billing/outbox/relay.py
@@ -0,0 +1,25 @@
+import asyncio
+
+from billing.db import pool
+from billing.queues import QUEUES, sqs
+
+
+async def relay_once() -> int:
+    async with pool.acquire() as conn:
+        rows = await conn.fetch(
+            "SELECT id, topic, payload FROM outbox WHERE published_at IS NULL ORDER BY id LIMIT 100"
+        )
+        for r in rows:
+            await conn.execute("UPDATE outbox SET published_at = now() WHERE id = $1", r["id"])
+            sqs.send_message(
+                QueueUrl=QUEUES[r["topic"]],
+                MessageBody=r["payload"],
+                MessageAttributes={"event_id": {"DataType": "String", "StringValue": str(r["id"])}},
+            )
+        return len(rows)
+
+
+async def run_forever() -> None:
+    while True:
+        if await relay_once() == 0:
+            await asyncio.sleep(1)
diff --git a/billing/consumers/usage_credits.py b/billing/consumers/usage_credits.py
new file mode 100644
--- /dev/null
+++ b/billing/consumers/usage_credits.py
@@ -0,0 +1,44 @@
+import json
+
+from billing.db import pool
+from billing.notify import send_email_with_retry
+from billing.queues import QUEUES, sqs
+
+LOW_BALANCE_FRACTION = 0.10
+
+
+async def handle(msg: dict) -> None:
+    event = json.loads(msg["Body"])
+    event_id = msg["MessageAttributes"]["event_id"]["StringValue"]
+
+    async with pool.acquire() as conn:
+        status = await conn.execute(
+            "INSERT INTO processed_events (event_id) VALUES ($1) ON CONFLICT DO NOTHING", event_id
+        )
+        if status == "INSERT 0 0":
+            return  # already processed
+
+        acct = await conn.fetchrow(
+            "SELECT credits, credits_purchased FROM accounts WHERE id = $1", event["account_id"]
+        )
+        new_balance = acct["credits"] - event["units"]
+        await conn.execute(
+            "UPDATE accounts SET credits = $1 WHERE id = $2", new_balance, event["account_id"]
+        )
+
+    if new_balance < acct["credits_purchased"] * LOW_BALANCE_FRACTION:
+        await send_email_with_retry(event["account_id"], template="low_balance")
+
+
+async def poll_forever() -> None:
+    while True:
+        resp = sqs.receive_message(
+            QueueUrl=QUEUES["usage.recorded"],
+            MaxNumberOfMessages=10,
+            VisibilityTimeout=30,
+            WaitTimeSeconds=20,
+            MessageAttributeNames=["All"],
+        )
+        for msg in resp.get("Messages", []):
+            await handle(msg)
+            sqs.delete_message(QueueUrl=QUEUES["usage.recorded"], ReceiptHandle=msg["ReceiptHandle"])
diff --git a/billing/notify.py b/billing/notify.py
--- a/billing/notify.py
+++ b/billing/notify.py
@@ -1,3 +1,13 @@
+import asyncio
+
 import httpx

 MAILER_URL = "https://mailer.internal/v1/send"
 http = httpx.AsyncClient()
+
+
+async def send_email_with_retry(account_id: str, template: str, attempts: int = 5):
+    for i in range(attempts):
+        try:
+            return await http.post(MAILER_URL, json={"account_id": account_id, "template": template}, timeout=2.0)
+        except (httpx.TimeoutException, httpx.HTTPStatusError):
+            await asyncio.sleep(2 ** i)
