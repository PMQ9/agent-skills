diff --git a/src/routes/reservations.ts b/src/routes/reservations.ts
new file mode 100644
--- /dev/null
+++ b/src/routes/reservations.ts
@@ -0,0 +1,30 @@
+import { Router } from "express";
+import { db } from "../db";
+import { requireAuth } from "../auth";
+
+export const reservations = Router();
+
+reservations.post("/v1/reservations", requireAuth, async (req, res) => {
+  const { productId, quantity } = req.body;
+  const result = await db.tx(async (t) => {
+    const product = await t.one("SELECT id, stock FROM products WHERE id = $1 FOR UPDATE", [productId]);
+    if (product.stock < quantity) {
+      return { ok: false as const };
+    }
+    await t.none("UPDATE products SET stock = stock - $1 WHERE id = $2", [quantity, productId]);
+    const r = await t.one(
+      "INSERT INTO reservations (product_id, quantity, cart_id, expires_at) VALUES ($1, $2, $3, now() + interval '15 minutes') RETURNING id, expires_at",
+      [productId, quantity, req.user.cartId],
+    );
+    return { ok: true as const, reservation: r };
+  });
+  if (!result.ok) {
+    return res.status(409).json({ type: "https://errors.acme.com/out-of-stock", title: "Out of stock", status: 409 });
+  }
+  res.status(201).json({
+    id: result.reservation.id,
+    productId,
+    quantity,
+    expiresAt: result.reservation.expires_at.toISOString(),
+  });
+});
