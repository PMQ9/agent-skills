diff --git a/src/consumers/carrierEvents.ts b/src/consumers/carrierEvents.ts
new file mode 100644
--- /dev/null
+++ b/src/consumers/carrierEvents.ts
@@ -0,0 +1,33 @@
+import { db } from "../db";
+import { bus } from "../bus";
+
+const STATUS_FOR_EVENT: Record<string, string> = {
+  "shipment.in_transit": "in_transit",
+  "shipment.delivered": "delivered",
+  "shipment.returned": "returned",
+};
+
+bus.subscribe("carrier.events", async (msg) => {
+  const evt = JSON.parse(msg.body);
+  const status = STATUS_FOR_EVENT[evt.type];
+  const order = await db.orders.byTrackingNumber(evt.trackingNumber);
+
+  await db.orders.update(order.id, {
+    status,
+    carrier_eta: evt.estimatedDelivery ? new Date(evt.estimatedDelivery) : null,
+  });
+
+  if (status === "returned") {
+    await db.tx(async (t) => {
+      const items = await t.many("SELECT product_id, quantity FROM order_items WHERE order_id = $1", [order.id]);
+      for (const it of items) {
+        await t.none("UPDATE products SET stock = stock + $1 WHERE id = $2", [it.quantity, it.product_id]);
+      }
+    });
+  }
+
+  if (status === "delivered") {
+    await bus.publish("order.delivered", { orderId: order.id });
+  }
+  msg.ack();
+});
