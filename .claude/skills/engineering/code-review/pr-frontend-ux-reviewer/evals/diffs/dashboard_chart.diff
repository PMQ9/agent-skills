+import * as Icons from "lucide-react";
+import { Bar } from "react-chartjs-2";
+import { Chart, registerables } from "chart.js";
+import moment from "moment";
+import _ from "lodash";
+
+Chart.register(...registerables);
+
+export function EnrollmentCard({ termId }: { termId: string }) {
+  const { data: term } = useQuery({
+    queryKey: ["term", termId],
+    queryFn: () => fetch(`/api/terms/${termId}`).then((r) => r.json()),
+  });
+
+  // depends on term.code, so it can't start until the request above resolves
+  const { data: enrollments, isLoading } = useQuery({
+    queryKey: ["enrollments", term?.code],
+    enabled: !!term?.code,
+    queryFn: () => fetch(`/api/enrollments?term=${term.code}`).then((r) => r.json()),
+  });
+
+  const byMajor = _.groupBy(enrollments ?? [], "major");
+  const labels = Object.keys(byMajor).sort();
+
+  if (isLoading) return <Spinner />;
+
+  return (
+    <div className="rounded-xl border bg-card p-6">
+      <div className="mb-4 flex items-center justify-between">
+        <h2 className="text-lg font-semibold">Enrollment by major</h2>
+        <span className="text-sm text-muted-foreground">
+          Updated {moment(enrollments[0]?.updatedAt).fromNow()}
+        </span>
+      </div>
+      <Bar
+        data={{
+          labels,
+          datasets: [{ data: labels.map((l) => byMajor[l].length), backgroundColor: "#C9A227" }],
+        }}
+        options={{ animation: { duration: 600 } }}
+      />
+      <div className="mt-4 flex gap-4">
+        {labels.map((l) => (
+          <div key={l} className="flex items-center gap-1 text-xs">
+            <Icons.CircleIcon size={10} />
+            {l}
+          </div>
+        ))}
+      </div>
+    </div>
+  );
+}

