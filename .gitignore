.claude/settings.json
.DS_Store
.gitignore

# # Local-only visible symlink -> .claude (so the hidden dotfolder shows in Finder)
# /claude

# Per-skill workspace artifacts from skill development / eval runs
# Any *-workspace/ dir (skill-dev / eval scratch), anywhere in the tree
*-workspace/
.claude/skills/engineering/backend/**/*.json
.claude/skills/engineering/backend/api-design-workspace/**/*.md
.claude/skills/engineering/backend/api-design-workspace/**/*.html
.claude/skills/engineering/backend/api-design-workspace/iteration-2/grade.py
.claude/skills/engineering/backend/api-design-workspace/iteration-2/build_viewer.py
.claude/skills/engineering/backend/api-design-workspace/iteration-3/

# Repo-root skill-review artifacts (regenerated each iteration)
skill-review*.html
skill-review-outputs/
SKILL-SUITE-CHANGES.md

# Built .skill packages (derived from SKILL.md sources)
*.skill

local-ai/claude-assistant-workspace/*
.claude/skills/engineering/ai/local-llm-delegation-workspace/*
_vibe-check/*
*.pdf
